{
  "name": "uno-arena",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "UNO Arena - Real-time multiplayer card game featuring Classic, Flip, and Show 'em No Mercy",
  "main": "server/src/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/src/index.js",
    "test": "node --test --test-concurrency=1 server/tests/*.test.js",
    "test:browser": "node scripts/verify_browsers.js",
    "test:mobile": "node scripts/verify_mobile_ui.mjs && node scripts/verify_responsive_landing.mjs",
    "test:load": "node scripts/load_rooms.mjs",
    "test:mobile:fullscreen": "node scripts/verify_mobile_fullscreen.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "qrcode-generator": "^2.0.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "jsqr": "^1.4.0"
  }
}
